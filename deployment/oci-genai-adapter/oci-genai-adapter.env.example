# Copy to /etc/oci-genai-adapter.env. Do not commit the populated file.
# Authentication is provided by the OCI Instance Principal attached to the VM.

OCI_REGION=<your-region>
OCI_COMPARTMENT_ID=<your-compartment-ocid>
OCI_CHAT_MODEL=cohere.command-a-03-2025
OCI_TOOL_MODEL=cohere.command-a-03-2025
OCI_VISION_MODEL=cohere.command-a-vision
OCI_EMBED_MODEL=cohere.embed-v4.0
OCI_EMBED_DIMENSIONS=1536
OCI_MAX_OUTPUT_TOKENS=2048
